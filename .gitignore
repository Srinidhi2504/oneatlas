# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (rebuilt by `npm run db:generate`)
/src/generated

# keep the env template
!.env.example

# playwright
/test-results
/playwright-report

# generated at build time by scripts/build-code-index.ts
/public/oneatlas-source.zip

# ndemo (demo-video toolkit, cloned from github.com/splitbrain/ndemo) and its generated output
/.claude/skills/ndemo/
/.ndemo/
/demo/*/audio/
/demo/*/video-raw/
/demo/*/.frames/
/demo/*/*.mp4
/demo/*/*.mp3
/demo/*/*.srt
