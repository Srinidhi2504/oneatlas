# Copy to .env (NOT .env.local: Next, Prisma CLI and tsx scripts all read plain .env).
# Neon: DATABASE_URL = pooled string (host contains "-pooler"), DIRECT_URL = direct/unpooled string.
# Use sslmode=verify-full on Neon strings (plain "require" triggers a pg deprecation warning); drop channel_binding=...
# Local Postgres: set both to the same URL, or omit DIRECT_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/oneatlas"
DIRECT_URL="postgresql://user:password@localhost:5432/oneatlas"

# Optional (P5): enables POST /api/internal/revalidate. Generate with: node -e "console.log(crypto.randomUUID())"
REVALIDATE_SECRET=
